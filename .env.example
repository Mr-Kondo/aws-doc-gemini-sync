# Copy to .env and fill in. NEVER commit .env.
# Only variable NAMES belong in this file.
#
# There are only TWO values you have to go and obtain. Everything below that is
# either optional or a path this tool writes to by itself.

# =====================================================================
# 1. Values you obtain from Google (see README "Google Cloud setup")
# =====================================================================

# The OAuth client JSON downloaded from:
#   Google Auth Platform -> Clients -> Create Client -> Desktop app
GOOGLE_CLIENT_SECRETS_FILE=

# The destination Drive folder, taken from its URL:
#   https://drive.google.com/drive/folders/<THIS PART>
GOOGLE_DRIVE_FOLDER_ID=


# =====================================================================
# 2. Written BY this tool -- nothing to obtain, safe to leave blank
# =====================================================================

# Where the OAuth refresh token is cached after the first browser consent.
# The file does not exist yet and you do not create it: the first real sync
# writes it here (owner-only, 0600) and later runs reuse it without a browser.
# Leave blank to use the default: .state/token.json
# Delete the file to force re-authorization.
GOOGLE_TOKEN_PATH=


# =====================================================================
# 3. Optional overrides
# =====================================================================

# Supply the OAuth client inline instead of GOOGLE_CLIENT_SECRETS_FILE above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Service account instead of OAuth, for unattended execution (see README).
GOOGLE_AUTH_METHOD=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_IMPERSONATE_SUBJECT=

# Local state and logging.
AWS_DOC_SYNC_MANIFEST_PATH=
AWS_DOC_SYNC_LOG_LEVEL=
AWS_DOC_SYNC_LOG_FORMAT=
